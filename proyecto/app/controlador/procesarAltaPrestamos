<?php

require_once __DIR__ . "/../../config/config.php";
require_once RUTA_MODELO . "/ConectorPDO.php";
require_once RUTA_MODELO . "/AltaPrestamos.php";

session_start();
// ... resto del código igual


//Comprueba que el formulario haya sido enviado mediante POST
if ($_SERVER["REQUEST_METHOD"] !== "POST") {
    $mensaje = "Acceso Denegado: Petición incorrecta";

    header("Location: prestamo.php?error=" . urlencode($mensaje));
    exit;
}

//Comprueba que haya un técnico logueado (cedula es NOT NULL y FK en la tabla PRESTAMO)
if (!isset($_SESSION["cedula"]) || !$_SESSION["tecnico"]) {
    $mensaje = "Debe iniciar sesión como técnico para registrar un préstamo.";

    header("Location: prestamo.php?error=" . urlencode($mensaje));
    exit;
}

//Recupera los datos del formulario, con variables nombradas según las columnas de PRESTAMO
$cedula         = $_SESSION["cedula"];
$ciAlumno       = trim($_POST["CI_empleado"] ?? "");
$nombreAlumno   = trim($_POST["nombreAlumnoPrestamo"] ?? "");
$apellidoAlumno = trim($_POST["apellidoAlumnoPrestamo"] ?? "");
$fechaInicio    = $_POST["fechaPrestamo"] ?? "";
$fechaLimite    = $_POST["fechaDevolucion"] ?? "";
$estadoPrestamo = trim($_POST["estadoEquipos"] ?? "");

$conectorPDO = new ConectorPDO("localhost", "tecnoemmn", "123", "test");

$conexion = $conectorPDO->establecerConexion();

if ($conexion === null) {
    $mensaje = "No se pudo establecer conexión con la base de datos.";

    header("Location: prestamo.php?error=" . urlencode($mensaje));
    exit;
}

$altaPrestamos = new AltaPrestamos($conexion);

$resultado = $altaPrestamos->registrarPrestamo($cedula, $ciAlumno, $nombreAlumno, $apellidoAlumno, $fechaInicio, $fechaLimite, $estadoPrestamo);

$conectorPDO->desconectar();


if (!$resultado) {
    $mensaje = "No se pudo registrar el préstamo.";

    header("Location: prestamo.php?error=" . urlencode($mensaje));
    exit;
}

$mensaje = "Préstamo registrado exitosamente.";
header("Location: prestamo.php?resultado=" . urlencode($mensaje));
exit;

?>