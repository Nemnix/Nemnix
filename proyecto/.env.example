# Plantilla de configuración de la base de datos.
# Copiá este archivo como ".env" (en esta misma carpeta) y completá tus datos.
# El .env no se sube a git; este archivo sí.

# Servidor y puerto de MySQL/MariaDB
DB_HOST=localhost
DB_PUERTO=3306

# Usuario y clave de MySQL
DB_USUARIO=
DB_CLAVE=

# Nombre de la base de datos
DB_NOMBRE=
